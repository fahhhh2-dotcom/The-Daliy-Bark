rules_version = '2';
// Pulse security rules — paste into Firebase console → Firestore Database → Rules → Publish.
// Anyone can READ public posts and profiles. Only signed-in people can write,
// and only their own things. Admins (a doc in the "admins" collection with
// their user ID) can delete anything to moderate.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(me())); }
    function data() { return request.resource.data; }
    function postAuthor(pid) {
      return exists(/databases/$(database)/documents/posts/$(pid))
        && get(/databases/$(database)/documents/posts/$(pid)).data.author == me();
    }
    function str(v, max) { return v is string && v.size() <= max; }
    // Cast Guard: banned people can't post, and blocked words are refused by the database too
    function notBanned() { return !exists(/databases/$(database)/documents/banned/$(me())); }
    function clean(t) { return !(t.lower().matches('(?s).*(^|[^a-z])(fuck|fucking|fucker|fucked|motherfucker|shit|bullshit|bitch|bastard|asshole|dick|dickhead|cock|pussy|cunt|twat|whore|slut|fag|faggot|nigger|nigga|retard|retarded|tranny|chink|spic|kike|porn|porno|nudes|onlyfans|hentai|rape|rapist|pedo|pedophile|kys|kill ?yourself|kill ?urself|neck ?yourself)([^a-z]|$).*')); }

    // Usernames: one owner each, first come first served
    match /handles/{h} {
      allow read: if true;
      allow create: if signedIn() && data().user == me() && h.matches('^[a-z0-9_]{3,20}$');
      allow delete: if signedIn() && (resource.data.user == me() || isAdmin());
    }

    // Profiles: you can only write your own, with a username you own
    match /profiles/{uid} {
      allow read: if true;
      allow write: if signedIn() && uid == me() && data().user == me()
        && str(data().handle, 20) && str(data().displayName, 40)
        && str(data().bio, 160) && str(data().website, 100)
        && clean(data().handle) && clean(data().displayName) && clean(data().bio)
        && getAfter(/databases/$(database)/documents/handles/$(data().handle)).data.user == me();
      allow delete: if isAdmin();
    }

    // Posts: create your own (280 chars max); delete your own; no editing
    match /posts/{pid} {
      allow read: if true;
      allow create: if signedIn() && data().author == me() && notBanned()
        && str(data().text, 280) && clean(data().text)
        && data().createdAt is number
        && (!('image' in data()) || str(data().image, 400000))
        && (!('title' in data()) || (str(data().title, 100) && clean(data().title)));
      // video views: anyone can add exactly one view at a time
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        && request.resource.data.views == resource.data.get('views', 0) + 1;
      allow delete: if signedIn() && (resource.data.author == me() || isAdmin());
    }

    match /comments/{cid} {
      allow read: if true;
      allow create: if signedIn() && data().author == me() && notBanned() && str(data().text, 500) && clean(data().text);
      allow delete: if signedIn() && (resource.data.author == me() || isAdmin() || postAuthor(resource.data.post));
    }

    // Likes, reposts and poll votes: id is "<postId>__<yourUserId>"
    match /likes/{id} {
      allow read: if true;
      allow create: if signedIn() && data().user == me() && id == data().post + '__' + me();
      allow delete: if signedIn() && (resource.data.user == me() || isAdmin() || postAuthor(resource.data.post));
    }
    match /reposts/{id} {
      allow read: if true;
      allow create: if signedIn() && data().user == me() && id == data().post + '__' + me();
      allow delete: if signedIn() && (resource.data.user == me() || isAdmin() || postAuthor(resource.data.post));
    }
    match /votes/{id} {
      allow read: if true;
      allow create, update: if signedIn() && data().user == me() && id == data().post + '__' + me() && data().choice is int;
      allow delete: if signedIn() && (resource.data.user == me() || isAdmin() || postAuthor(resource.data.post));
    }

    // Follows: id is "<yourUserId>__<theirUserId>"
    match /follows/{id} {
      allow read: if true;
      allow create: if signedIn() && data().from == me() && id == me() + '__' + data().to;
      allow delete: if signedIn() && (resource.data.from == me() || isAdmin());
    }

    // Videos (free mode): each video is saved as pieces "<videoId>_<n>"
    match /videoChunks/{id} {
      allow read: if true;
      allow create: if signedIn() && data().owner == me()
        && data().i is int && data().i >= 0 && data().i < 40
        && id == data().vid + '_' + string(data().i)
        && str(data().data, 1000000);
      allow delete: if signedIn() && (resource.data.owner == me() || isAdmin());
    }

    // Stories: disappear from the app after 24 hours
    match /stories/{sid} {
      allow read: if true;
      allow create: if signedIn() && data().author == me() && notBanned() && data().createdAt is number
        && (!('image' in data()) || str(data().image, 400000));
      allow delete: if signedIn() && (resource.data.author == me() || isAdmin());
    }

    // Private messages & group chats: only people in a chat can read or write it.
    // Public groups can be seen and joined by anyone who is signed in.
    match /convos/{cid} {
      function newM() { return request.resource.data.members; }
      function isGroup(d) { return d.get('group', false) == true; }
      function isPublic(d) { return d.get('public', false) == true; }
      allow read: if signedIn() && (me() in resource.data.members || isPublic(resource.data));
      allow create: if signedIn() && newM() is list && me() in newM() && (
        (!isGroup(request.resource.data) && newM().size() == 2 && newM()[0] < newM()[1]
          && cid == newM()[0] + '__' + newM()[1])
        || (isGroup(request.resource.data) && (newM().size() >= 2 || isPublic(request.resource.data)) && newM().size() <= 101
          && request.resource.data.owner == me() && str(request.resource.data.name, 40) && clean(request.resource.data.name)));
      // join a public group: add only yourself
      allow update: if signedIn() && isGroup(resource.data) && isPublic(resource.data) && !(me() in resource.data.members)
        && newM().hasAll(resource.data.members) && newM().size() == resource.data.members.size() + 1
        && me() in newM() && newM().size() <= 500
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'read']);
      allow update: if signedIn() && me() in resource.data.members
        && isGroup(request.resource.data) == isGroup(resource.data)
        && request.resource.data.get('owner', '') == resource.data.get('owner', '')
        && (isPublic(request.resource.data) == isPublic(resource.data) || resource.data.get('owner', '') == me())
        && (newM() == resource.data.members
          || (isGroup(resource.data) && resource.data.owner == me() && newM().size() <= 500 && me() in newM())
          || (isGroup(resource.data) && resource.data.members.hasAll(newM())
              && newM().size() == resource.data.members.size() - 1 && !(me() in newM())));
      match /messages/{mid} {
        allow read: if signedIn() && (me() in get(/databases/$(database)/documents/convos/$(cid)).data.members
          || get(/databases/$(database)/documents/convos/$(cid)).data.get('public', false) == true);
        allow create: if signedIn() && data().from == me() && notBanned() && str(data().text, 1000) && clean(data().text)
          && me() in get(/databases/$(database)/documents/convos/$(cid)).data.members;
      }
    }

    // Bookmarks & "last seen" — private to each person
    match /private/{uid} {
      allow read, write: if signedIn() && uid == me();
    }

    // Cast Guard reports: one report per person per thing; admins review them
    match /reports/{rid} {
      allow read: if signedIn();
      allow create: if signedIn() && data().reporter == me() && rid == data().target + '__' + me()
        && str(data().reason, 40) && str(data().type, 20) && (!('text' in data()) || str(data().text, 300));
      allow delete: if signedIn() && (isAdmin() || resource.data.reporter == me());
    }

    // Banned people (only admins can ban or unban)
    match /banned/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Ads the admin plays for everyone
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Who saw each ad (so the dashboard can count)
    match /adViews/{vid} {
      allow read: if isAdmin();
      allow create: if signedIn() && data().user == me() && vid == data().bid + '__' + me();
    }

    // Marquee (streaming site): each person's profiles and My List, private to them
    match /marquee/{uid} {
      allow read, write: if signedIn() && uid == me();
    }

    // Admin list — you add yourself here by hand in the console
    match /admins/{uid} {
      allow read: if signedIn() && uid == me();
      allow write: if false;
    }
  }
}
